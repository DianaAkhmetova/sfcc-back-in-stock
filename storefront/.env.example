# Copy to .env (git-ignored). Loaded by `npm start`, `npm run build` and `npm run push`.
# For Managed Runtime, also add the same variables to the MRT environment
# (Runtime Admin > project > environment > Environment Variables).

# SLAS public client for f_ecom_zzft_001 (channel RefArch, scope c_consumer_rw + standard shopper scopes).
# Leave empty to use the public Salesforce demo catalog instead.
PWA_SLAS_CLIENT_ID=
